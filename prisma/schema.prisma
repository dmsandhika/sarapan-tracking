generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Kept as string unions in TS instead of native Prisma enums:
// DayStatus: "DRAFT" | "PUBLISHED" | "CLOSED"
// MenuItemStatus: "AVAILABLE" | "HABIS"

model Day {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  status    String   @default("DRAFT")
  imageUrl  String?
  createdAt DateTime @default(now())

  menuItems MenuItem[]
  orders    Order[]
}

model MenuItem {
  id        String @id @default(cuid())
  dayId     String
  day       Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  name      String
  status    String @default("AVAILABLE")
  sortOrder Int    @default(0)

  orderItems         OrderItem[] @relation("CurrentItem")
  substitutedOrders  OrderItem[] @relation("OriginalItem")
}

model Customer {
  id        String   @id @default(cuid())
  waNumber  String   @unique
  name      String
  createdAt DateTime @default(now())

  orders Order[]
}

model Order {
  id         String   @id @default(cuid())
  dayId      String
  day        Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  nomorUrut  Int
  name       String
  paid       Boolean  @default(false)
  billAmount Int?
  createdAt  DateTime @default(now())

  items OrderItem[]

  @@unique([dayId, nomorUrut])
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String
  menuItem           MenuItem  @relation("CurrentItem", fields: [menuItemId], references: [id])
  originalMenuItemId String?
  originalMenuItem   MenuItem? @relation("OriginalItem", fields: [originalMenuItemId], references: [id])
  qty                Int       @default(1)
  note               String?
}
