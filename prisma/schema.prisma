generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Kept as string unions in TS instead of native Prisma enums:
// SessionStatus: "DRAFT" | "PUBLISHED" | "CLOSED"
// SessionMode: "MENU" | "FREETEXT"
// MenuItemStatus: "AVAILABLE" | "HABIS"

model Session {
  id             String   @id @default(cuid())
  publicCode     String   @unique
  title          String
  date           String // YYYY-MM-DD Asia/Jakarta, date created — not unique
  mode           String   @default("MENU")
  status         String   @default("DRAFT")
  imageUrl       String?
  vendorWaNumber String?
  warungId       String?
  warung         Warung?  @relation(fields: [warungId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  menuItems MenuItem[]
  orders    Order[]

  @@index([date])
}

model MenuItem {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  status    String  @default("AVAILABLE")
  sortOrder Int     @default(0)
  price     Int? // snapshot harga dari WarungMenuItem, opsional

  orderItems        OrderItem[] @relation("CurrentItem")
  substitutedOrders OrderItem[] @relation("OriginalItem")
}

model Customer {
  id        String   @id @default(cuid())
  waNumber  String   @unique
  name      String
  createdAt DateTime @default(now())

  orders Order[]
}

model Order {
  id               String    @id @default(cuid())
  sessionId        String
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  nomorUrut        Int
  name             String
  paid             Boolean   @default(false)
  paidAt           DateTime?
  billAmount       Int?
  paymentProofPath String?
  createdAt        DateTime  @default(now())

  items OrderItem[]

  @@unique([sessionId, nomorUrut])
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String?
  menuItem           MenuItem? @relation("CurrentItem", fields: [menuItemId], references: [id])
  originalMenuItemId String?
  originalMenuItem   MenuItem? @relation("OriginalItem", fields: [originalMenuItemId], references: [id])
  customText         String?
  qty                Int       @default(1)
  note               String?
}

// Pengaturan global yang bisa diubah admin (key/value), mis. "maxUnpaidOrders".
model AppSetting {
  key   String @id
  value String
}

// Master data warung langganan beserta daftar lauknya. Saat sesi dibuat, lauk yang
// dicentang disalin (snapshot) ke MenuItem sehingga riwayat tidak berubah kalau
// lauk di warung diedit/dihapus.
model Warung {
  id        String   @id @default(cuid())
  name      String
  waNumber  String?
  note      String?
  createdAt DateTime @default(now())

  items    WarungMenuItem[]
  sessions Session[]
}

model WarungMenuItem {
  id        String  @id @default(cuid())
  warungId  String
  warung    Warung  @relation(fields: [warungId], references: [id], onDelete: Cascade)
  name      String
  price     Int?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
}
