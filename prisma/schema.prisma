generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Kept as string unions in TS instead of native Prisma enums:
// SessionStatus: "DRAFT" | "PUBLISHED" | "CLOSED"
// SessionMode: "MENU" | "FREETEXT"
// MenuItemStatus: "AVAILABLE" | "HABIS"

model Session {
  id             String   @id @default(cuid())
  publicCode     String   @unique
  title          String
  date           String // YYYY-MM-DD Asia/Jakarta, date created — not unique
  mode           String   @default("MENU")
  status         String   @default("DRAFT")
  imageUrl       String?
  vendorWaNumber String?
  createdAt      DateTime @default(now())

  menuItems MenuItem[]
  orders    Order[]

  @@index([date])
}

model MenuItem {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  status    String  @default("AVAILABLE")
  sortOrder Int     @default(0)

  orderItems        OrderItem[] @relation("CurrentItem")
  substitutedOrders OrderItem[] @relation("OriginalItem")
}

model Customer {
  id        String   @id @default(cuid())
  waNumber  String   @unique
  name      String
  createdAt DateTime @default(now())

  orders Order[]
}

model Order {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  nomorUrut  Int
  name       String
  paid       Boolean  @default(false)
  billAmount Int?
  createdAt  DateTime @default(now())

  items OrderItem[]

  @@unique([sessionId, nomorUrut])
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String?
  menuItem           MenuItem? @relation("CurrentItem", fields: [menuItemId], references: [id])
  originalMenuItemId String?
  originalMenuItem   MenuItem? @relation("OriginalItem", fields: [originalMenuItemId], references: [id])
  customText         String?
  qty                Int       @default(1)
  note               String?
}
